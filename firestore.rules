rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nossoapp01@gmail.com' ||
        request.auth.uid == 'super-admin-direct'
      );
    }

    function isTenantOwner(tenantId) {
      return isSignedIn() && (request.auth.uid == tenantId || isSuperAdmin());
    }

    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Diagnostics / Connectivity test document
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // User profile isolation
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Product validation helper
    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 150 &&
             data.category is string &&
             data.price is number && data.price >= 0 &&
             data.refCode is string && data.refCode.size() <= 50 &&
             data.whatIsItFor is string && data.whatIsItFor.size() <= 500 &&
             data.image is string && data.image.size() <= 1000;
    }

    // Banner slides validation
    function isValidBanner(data) {
      return data.title is string && data.title.size() <= 150 &&
             data.subtitle is string && data.subtitle.size() <= 300 &&
             data.image is string && data.image.size() <= 1000;
    }

    // Testimonials
    function isValidTestimonial(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.protocol is string && data.protocol.size() <= 100 &&
             data.weightLost is string && data.weightLost.size() <= 60 &&
             data.beforeImage is string && data.beforeImage.size() <= 1000 &&
             data.afterImage is string && data.afterImage.size() <= 1000 &&
             data.quote is string && data.quote.size() <= 1000;
    }

    // Store settings
    function isValidSettings(data) {
      return data.storeName is string && data.storeName.size() <= 120 &&
             data.currencySymbol is string && data.currencySymbol.size() <= 5 &&
             (!('defaultPaymentLink' in data) || (data.defaultPaymentLink is string && data.defaultPaymentLink.size() <= 1000));
    }

    // Orders
    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status is string && data.status.size() <= 30;
    }

    // ==========================================
    // MULTI-TENANT ISOLATED SAAS WORKSPACES
    // ==========================================

    match /tenants/{tenantId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(tenantId);

      // Tenant Products Catalog
      match /products/{productId} {
        allow read, list: if true;
        allow create, update, delete: if isValidId(productId);
      }

      // Tenant Orders
      match /orders/{orderId} {
        allow read, list, write: if isValidId(orderId);
      }

      // Tenant Banners
      match /banners/{bannerId} {
        allow read, list, write: if isValidId(bannerId);
      }

      // Tenant Testimonials
      match /testimonials/{testimonialId} {
        allow read, list, write: if isValidId(testimonialId);
      }

      // Tenant Settings
      match /settings/{settingId} {
        allow read, write: if isValidId(settingId);
      }
    }

    // ==========================================
    // ROOT / PLATFORM FALLBACK COLLECTIONS
    // ==========================================

    // Products catalog
    match /products/{productId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(productId);
    }

    // Banner slides
    match /banners/{bannerId} {
      allow read, write: if isValidId(bannerId);
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read, write: if isValidId(testimonialId);
    }

    // Store settings
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Platform Metadata & Deleted Sync
    match /platform_meta/{metaId} {
      allow read, write: if isValidId(metaId);
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
    }

    // Validation for Chat Signaling & Active Call
    function isValidActiveCall(call) {
      return call == null || (
        call is map &&
        call.callId is string && call.callId.size() <= 128 &&
        call.chatId is string && call.chatId.size() <= 128 &&
        call.callType in ['voice', 'video'] &&
        call.status in ['ringing', 'connecting', 'connected', 'ended', 'declined', 'missed'] &&
        call.caller in ['customer', 'admin'] &&
        call.receiver in ['customer', 'admin'] &&
        (!('callerName' in call) || (call.callerName is string && call.callerName.size() <= 120)) &&
        (!('receiverName' in call) || (call.receiverName is string && call.receiverName.size() <= 120))
      );
    }

    // Validation for Chat Conversation
    function isValidChat(data) {
      return data is map &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120)) &&
             (!('customerContact' in data) || (data.customerContact is string && data.customerContact.size() <= 120)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 8000)) &&
             (!('activeCall' in data) || isValidActiveCall(data.activeCall));
    }

    // Validation for Chat Message
    function isValidChatMessage(data) {
      return data is map &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('chatId' in data) || (data.chatId is string && data.chatId.size() <= 128)) &&
             (!('sender' in data) || data.sender in ['customer', 'admin']) &&
             (!('text' in data) || (data.text is string && data.text.size() <= 8000)) &&
             (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2000000)) &&
             (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 2000000));
    }

    // WhatsApp Direct Client Chats
    match /chats/{chatId} {
      allow get: if isValidId(chatId);
      allow list: if true;
      allow create, update: if isValidId(chatId) && isValidChat(incoming());
      allow delete: if isAdmin() && isValidId(chatId);

      match /messages/{messageId} {
        allow get: if isValidId(messageId);
        allow list: if isValidId(chatId);
        allow create, update: if isValidId(chatId) && isValidId(messageId) && isValidChatMessage(incoming());
        allow delete: if isAdmin() && isValidId(messageId);
      }
    }
  }
}
